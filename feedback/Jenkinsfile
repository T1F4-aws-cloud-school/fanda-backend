pipeline {
    agent any

    environment {
        HARBOR_URL = '192.168.2.111'
        PROJECT_NAME = 'fanda-be'
        IMAGE_NAME = "${HARBOR_URL}/${PROJECT_NAME}/feedback-service"
        IMAGE_TAG = "${env.GIT_COMMIT.take(8)}"
        DOCKER_BUILDKIT = '1'
        GRADLE_OPTS = '-Dorg.gradle.daemon=false -Dorg.gradle.caching=false'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '30'))
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('트리거 검증') {
            steps {
                script {
                    def author = sh(script: "git log -1 --pretty=%an", returnStdout: true).trim()
                    def commitMessage = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()

                    // 1. 먼저 Jenkins CI 커밋 스킵 (무한 루프 방지)
                    if (author == "Jenkins CI" || commitMessage.contains('[skip ci]')) {
                        echo "Jenkins CI 커밋 감지 - 파이프라인 스킵"
                        env.SKIP_ALL = 'true'
                        currentBuild.result = 'SUCCESS'
                        return
                    }

                    // 2. 그 다음 경로 체크
                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD",
                        returnStdout: true
                    ).trim()

                    if (!changedFiles.contains('feedback/')) {
                        echo "feedback 서비스 변경 없음 - 스킵"
                        env.SKIP_ALL = 'true'
                        currentBuild.result = 'SUCCESS'
                        return
                    }

                    env.SKIP_ALL = 'false'
                }
            }
        }

        stage('환경 검증') {
            when { environment name: 'SKIP_ALL', value: 'false' }
            steps {
                echo "Feedback 서비스 빌드 시작: ${IMAGE_NAME}:${IMAGE_TAG}"
                dir('feedback') {
                    sh '''
                        # 필수 파일 존재 확인
                        for file in build.gradle src/main/java Dockerfile; do
                            [ ! -e "$file" ] && echo "필수 파일/디렉토리 누락: $file" && exit 1
                        done

                        # Gradle wrapper 실행 권한 확인
                        [ -f "gradlew" ] && chmod +x gradlew

                        echo "Feedback 서비스 환경 검증 완료"
                    '''
                }
            }
        }

        stage('애플리케이션 빌드') {
            when { environment name: 'SKIP_ALL', value: 'false' }
            steps {
                dir('feedback') {
                    sh '''
                        echo "Feedback 서비스 Gradle 빌드 시작..."
                        if [ -f "gradlew" ]; then
                            ./gradlew clean build -x test --no-daemon
                        else
                            gradle clean build -x test --no-daemon
                        fi

                        echo "Feedback 서비스 빌드 완료"
                    '''
                }
            }
        }

        stage('이미지 중복 확인') {
            when { environment name: 'SKIP_ALL', value: 'false' }
            steps {
                script {
                    env.SKIP_BUILD = sh(
                        script: "docker manifest inspect ${IMAGE_NAME}:${IMAGE_TAG} >/dev/null 2>&1",
                        returnStatus: true
                    ) == 0 ? 'true' : 'false'

                    echo env.SKIP_BUILD == 'true' ?
                        "이미지 재사용: ${IMAGE_NAME}:${IMAGE_TAG}" :
                        "새 이미지 빌드: ${IMAGE_NAME}:${IMAGE_TAG}"
                }
            }
        }

        stage('빌드 & 푸시') {
            when {
                allOf {
                    environment name: 'SKIP_ALL', value: 'false'
                    environment name: 'SKIP_BUILD', value: 'false'
                }
            }
            steps {
                dir('feedback') {
                    withCredentials([usernamePassword(
                        credentialsId: 'Harbor-credentials',
                        usernameVariable: 'HARBOR_USER',
                        passwordVariable: 'HARBOR_PASS'
                    )]) {
                        sh '''
                            # Docker 이미지 빌드
                            docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest \
                                --label "version=${IMAGE_TAG}" \
                                --label "build-date=$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
                                --label "service=feedback" .

                            # Harbor 로그인 및 이미지 푸시
                            echo "${HARBOR_PASS}" | docker login ${HARBOR_URL} -u "${HARBOR_USER}" --password-stdin
                            docker push ${IMAGE_NAME}:${IMAGE_TAG}
                            docker push ${IMAGE_NAME}:latest

                            echo "Feedback 서비스 빌드 완료: ${IMAGE_NAME}:${IMAGE_TAG}"
                        '''
                    }
                }
            }
        }

        stage('보안 스캔') {
            when {
                allOf {
                    environment name: 'SKIP_ALL', value: 'false'
                    environment name: 'SKIP_BUILD', value: 'false'
                }
            }
            steps {
                sh '''
                    echo "Trivy 보안 스캔 실행..."
                    trivy image --server http://192.168.2.100:30367 \
                        --exit-code 1 --severity CRITICAL ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('AWS Secret 배포') {
            when { environment name: 'SKIP_ALL', value: 'false' }
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY'),
                    string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_KEY'),
                    string(credentialsId: 'aws-session-token', variable: 'AWS_SESSION_TOKEN'),
                    string(credentialsId: 'kubeconfig-base64', variable: 'KUBECONFIG_B64')
                ]) {
                    sh '''
                        echo "AWS Secret 배포 시작..."

                        # kubeconfig 설정
                        echo $KUBECONFIG_B64 | base64 -d > /tmp/kubeconfig
                        export KUBECONFIG=/tmp/kubeconfig
                        chmod 600 /tmp/kubeconfig
                        export PATH=$PATH:/usr/local/bin:/usr/bin

                        # kubectl 확인
                        if ! which kubectl > /dev/null 2>&1; then
                            echo "kubectl이 설치되지 않았습니다."
                            echo "PATH: $PATH"
                            which kubectl || echo "kubectl not found"
                            exit 1
                        fi

                        echo "kubectl 경로: $(which kubectl)"

                        # 클러스터 연결 확인
                        echo "Kubernetes 클러스터 연결 확인..."
                        kubectl get nodes

                        # 기존 Secret 삭제
                        kubectl delete secret fanda-feedback-secret -n fanda-be-marketing --ignore-not-found=true

                        # AWS Secret 생성
                        kubectl create secret generic fanda-feedback-secret \
                          --from-literal=DB_ROOT_USERNAME="root" \
                          --from-literal=DB_ROOT_PASSWORD="rootpass" \
                          --from-literal=DB_USER_USERNAME="fandauser" \
                          --from-literal=DB_USER_PASSWORD="fandapass" \
                          --from-literal=AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY}" \
                          --from-literal=AWS_SECRET_ACCESS_KEY="${AWS_SECRET_KEY}" \
                          --from-literal=AWS_SESSION_TOKEN="${AWS_SESSION_TOKEN}" \
                          --from-literal=AWS_REGION="us-east-1" \
                          --from-literal=AWS_S3_BUCKET="fanda-bucket-aws9-3" \
                          --from-literal=KAFKA_BOOTSTRAP_SERVERS="kafka.fanda-kafka.svc.cluster.local:9092" \
                          --from-literal=JPA_DDL_AUTO="update" \
                          -n fanda-be-marketing

                        echo "AWS Secret 배포 완료!"

                        # Secret 검증
                        if kubectl get secret fanda-feedback-secret -n fanda-be-marketing > /dev/null 2>&1; then
                            echo "Secret 생성 확인됨"
                            kubectl describe secret fanda-feedback-secret -n fanda-be-marketing
                        else
                            echo "Secret 생성 실패"
                            exit 1
                        fi

                        rm -f /tmp/kubeconfig
                    '''
                }
            }
        }

        stage('배포 업데이트') {
            when { environment name: 'SKIP_ALL', value: 'false' }
            steps {
                script {
                    try {
                        sh '''
                            git config --global user.email "jenkins@company.com"
                            git config --global user.name "Jenkins CI"
                            git fetch origin && git checkout develop && git reset --hard origin/develop
                        '''

                        def currentTag = sh(
                            script: "grep -o 'image: .*/feedback-service:.*' feedback/k8s/deployment.yaml | cut -d':' -f3 || echo 'none'",
                            returnStdout: true
                        ).trim()

                        if (currentTag == env.IMAGE_TAG) {
                            echo "이미지 태그 동일 - 스킵"
                            return
                        }

                        sh '''
                            sed -i "s|image: ${HARBOR_URL}/${PROJECT_NAME}/feedback-service:.*|image: ${HARBOR_URL}/${PROJECT_NAME}/feedback-service:${IMAGE_TAG}|g" feedback/k8s/deployment.yaml
                            git add feedback/k8s/deployment.yaml
                            git commit -m "Auto-update feedback-service image tag to ${IMAGE_TAG} [skip ci]"
                        '''

                        withCredentials([usernamePassword(
                            credentialsId: 'github-credentials',
                            usernameVariable: 'GITHUB_USER',
                            passwordVariable: 'GITHUB_TOKEN'
                        )]) {
                            sh '''
                                git push https://${GITHUB_TOKEN}@github.com/T1F4-aws-cloud-school/fanda-backend.git HEAD:develop
                                echo "Git 푸시 성공"
                            '''
                        }

                        echo "배포 업데이트 완료 - ArgoCD가 배포를 진행합니다"

                    } catch (Exception e) {
                        echo "배포 업데이트 실패: ${e.message}"
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }

        stage('배포 상태 확인') {
            when { environment name: 'SKIP_ALL', value: 'false' }
            steps {
                withCredentials([string(credentialsId: 'kubeconfig-base64', variable: 'KUBECONFIG_B64')]) {
                    sh '''
                        echo "배포 상태 확인 중..."

                        echo $KUBECONFIG_B64 | base64 -d > /tmp/kubeconfig
                        export KUBECONFIG=/tmp/kubeconfig
                        chmod 600 /tmp/kubeconfig
                        export PATH=$PATH:/usr/local/bin:/usr/bin

                        echo "Pod 상태:"
                        kubectl get pods -n fanda-be-marketing -l app=fanda-feedback || echo "Pod 아직 생성되지 않음"

                        echo "Service 상태:"
                        kubectl get svc -n fanda-be-marketing -l app=fanda-feedback || echo "Service 아직 생성되지 않음"

                        echo "Secret 상태:"
                        kubectl get secret fanda-feedback-secret -n fanda-be-marketing

                        echo "배포 상태 확인 완료"
                        rm -f /tmp/kubeconfig
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.SKIP_ALL != 'true') {
                    sh '''
                        docker logout ${HARBOR_URL} 2>/dev/null || true
                        docker rmi ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest 2>/dev/null || true
                        docker system prune -f --volumes
                    '''
                }
            }
        }
        success {
            echo env.SKIP_ALL == 'true' ? "자동 스킵 완료" :
                 env.SKIP_BUILD == 'true' ? "이미지 재사용 성공" : "Feedback 서비스 CI/CD 성공"
        }
        unstable {
            echo "빌드 성공, Git 업데이트 실패"
        }
        failure {
            echo "Feedback 서비스 빌드 실패"
            withCredentials([string(credentialsId: 'kubeconfig-base64', variable: 'KUBECONFIG_B64')]) {
                sh '''
                    echo "=== 디버그 정보 ==="

                    echo $KUBECONFIG_B64 | base64 -d > /tmp/kubeconfig
                    export KUBECONFIG=/tmp/kubeconfig
                    chmod 600 /tmp/kubeconfig
                    export PATH=$PATH:/usr/local/bin:/usr/bin

                    kubectl get pods -n fanda-be-marketing -l app=fanda-feedback || true
                    kubectl describe secret fanda-feedback-secret -n fanda-be-marketing || true
                    kubectl get events -n fanda-be-marketing --sort-by='.lastTimestamp' | tail -10 || true

                    rm -f /tmp/kubeconfig
                '''
            }
        }
        cleanup {
            sh 'docker container prune -f || true'
        }
    }
}